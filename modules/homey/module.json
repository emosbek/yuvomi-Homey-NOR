{
  "manifestVersion": 1,
  "id": "homey",
  "name": "Homey",
  "version": "1.1.0",
  "description": "Pin Homey devices, flows and webhooks as buttons for the household.",
  "entry": "index.js",
  "style": "style.css",
  "settings": {
    "entry": "settings.js",
    "sections": ["household"],
    "labelKey": "settings.title"
  },
  "icon": "house",
  "accent": "#0B6E99",
  "menu": {
    "show": true,
    "label": "Homey",
    "labelKey": "menu",
    "icon": "house",
    "order": 80
  },
  "page": {
    "composition": "dashboard",
    "width": "wide",
    "navigation": "standard",
    "responsive": "standard"
  },
  "i18n": { "defaultLocale": "nb" },
  "capabilities": {
    "permissions": {
      "module": { "label": "Homey", "labelKey": "module", "icon": "house" },
      "widgets": [{ "id": "pins", "label": "Homey", "labelKey": "widgets.pins" }]
    },
    "widgets": [{
      "id": "pins",
      "entry": "widgets/pins.js",
      "label": "Homey",
      "labelKey": "widgets.pins",
      "icon": "house",
      "defaultSize": "2x2",
      "defaultVisible": true
    }],
    "api": { "prefix": "/api/extensions/homey" }
  }
}
